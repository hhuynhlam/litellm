#!/usr/bin/env bash

set -euo pipefail

# Configuration
IMAGE_NAME="ghcr.io/hhuynhlam/litellm"
PLATFORM="linux/amd64"
VERSION="${VERSION:-latest}"

# Build and push with multiple tags in one operation
docker buildx build \
  --platform "$PLATFORM" \
  --tag "${IMAGE_NAME}:${VERSION}" \
  --tag "${IMAGE_NAME}:latest" \
  --push \
  .
